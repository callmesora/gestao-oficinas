+        with self.assertRaises(ValueError):
+            self.evaluate()
+        self.data = copy.deepcopy(before)
+        self.data['cases'].append(copy.deepcopy(self.data['cases'][0]))
+        with self.assertRaises(ValueError):
+            self.evaluate()
+        self.data = before
+        self.data['cases'][0]['checks'] = [{'file': '../outside.ts', 'title': 'save and reopen'}]
+        with self.assertRaises(ValueError):
+            self.evaluate()
