{
  "name": "gestao-oficinas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:server": "tsx apps/server/src/main.ts",
    "dev:workflows": "node --import tsx apps/server/src/development.ts",
    "dev:local": "node --import tsx apps/server/src/development.ts analysis-local/sqlite-development/data.sqlite",
    "dev:local:stock": "node --import tsx apps/server/src/development.ts analysis-local/sqlite-development-stock/data.sqlite",
    "desktop:mac": "tauri dev --no-watch --config src-tauri/tauri.macos.conf.json --config src-tauri/tauri.macos-workflows.conf.json",
    "build:mac": "tauri build --debug --config src-tauri/tauri.macos.conf.json --bundles app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "bindings:generate": "node scripts/bindings.mjs --write",
    "bindings:check": "node scripts/bindings.mjs",
    "parity": "node scripts/py.mjs scripts/parity_check.py docs/parity/parity.csv --seed docs/parity/parity-seed.csv",
    "ui:check": "playwright test -c ui-check/playwright.config.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run rust:fmt && npm run rust:clippy && npm run rust:test && npm run bindings:check && npm run parity && npm run ui:inputs:check && npm run ui:check",
    "ui:inputs:check": "node scripts/py.mjs scripts/ui_inputs.py",
    "native:check": "npm run tauri -- build --debug --no-bundle && node scripts/native-smoke.mjs",
    "db:dry-run": "tsx apps/server/src/db/dry-run.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@tanstack/react-table": "8.21.3",
    "@tauri-apps/api": "2.12.4",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7",
    "pagedjs": "0.4.3",
    "playwright-core": "1.64.1",
    "@fontsource/noto-sans": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/domain",
    "apps/server"
  ],
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true
  }
}
