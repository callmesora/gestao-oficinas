{
  "mainBinaryName": "gestao-oficinas-launcher",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../analysis-local/windows-runtime/": "service/",
      "target/release/gestao-oficinas.exe": "gestao-oficinas.exe",
      "../setup/customer-installer-README.pt.txt": "LEIA-PRIMEIRO.txt"
    },
    "windows": {
      "allowDowngrades": false,
      "bundleVCRuntime": true,
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "languages": ["Portuguese", "English"]
      }
    }
  }
}
